#!/usr/bin/env bash
set -uo pipefail
MEMCAP_ROOT="${MEMCAP_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
LIB="$MEMCAP_ROOT/libexec"
# shellcheck source=/dev/null
. "$LIB/common.sh"
for m in config budget detect measure classify roots status diagnostics; do
  # shellcheck source=/dev/null
  . "$LIB/$m.sh"
done
# Not a bare `.`: sourcing a config with a syntax error aborts the sourcing but
# not the shell, so keys before the error apply and keys after it do not. One
# stray quote in DOCKER_BUDGET_GB left TOTAL_BUDGET_GB=99 applied and the Docker
# ceiling unset, i.e. an 87 GB agent budget on a 24 GB machine -- nothing over
# budget ever again, no tier ever firing, and a heartbeat certifying it healthy.
# mc_load_config checks the file before applying any of it and marks
# MC_CONFIG_BROKEN so the acting commands refuse instead of running on defaults.
mc_load_config || :

case "${1:-help}" in
  integrate|doctor)
    # shellcheck source=/dev/null
    . "$LIB/feedback.sh"
    mc_integrate "$@"
    ;;
  gc)
    [ $# -eq 1 ] || { echo 'usage: memcap gc' >&2; exit 2; }
    # shellcheck source=/dev/null
    . "$LIB/idle_gc.sh"
    mc_gc_status
    ;;
  run|queue)
    action="$1"; shift
    # shellcheck source=/dev/null
    . "$LIB/scheduler.sh"
    mc_scheduler_run "$action" "$@"
    ;;
  queue-hook)
    # shellcheck source=/dev/null
    . "$LIB/scheduler.sh"
    mc_scheduler_hook "${2:-codex}"
    ;;
  _queue-sample)
    # shellcheck source=/dev/null
    . "$LIB/scheduler.sh"
    mc_queue_sample
    ;;
  _queue-cancel)
    [ $# -eq 2 ] || exit 2
    # shellcheck source=/dev/null
    . "$LIB/scheduler.sh"
    # shellcheck source=/dev/null
    . "$LIB/enforce.sh"
    mc_queue_cancel "$2"
    ;;
  init)
    shift
    # shellcheck source=/dev/null
    . "$LIB/service.sh"
    # shellcheck source=/dev/null
    . "$LIB/notify.sh"
    # shellcheck source=/dev/null
    . "$LIB/init.sh"
    mc_run_init "$@"
    ;;
  status)
    # service.sh for the LaunchAgent row: a heartbeat proves a pass happened,
    # not that the thing meant to run one is loaded. `status` is the command
    # people actually type, so the check belongs here rather than only in
    # `memcap service status`, which nobody runs.
    # shellcheck source=/dev/null
    . "$LIB/service.sh"
    # docker.sh for the VM-ceiling row: the config's ceiling is only a request
    # until `memcap docker apply` writes it into Docker's own settings, and the
    # row is misleading when those two disagree.
    # shellcheck source=/dev/null
    . "$LIB/docker.sh"
    mc_render_status
    ;;
  diagnostics)
    if [ $# -ne 1 ]; then echo "usage: memcap diagnostics" >&2; exit 2; fi
    mc_render_diagnostics
    ;;
  feedback)
    [ $# -le 2 ] || { echo 'usage: memcap feedback [--wait]' >&2; exit 2; }
    # shellcheck disable=SC2034 # consumed by sourced idle_gc.sh
    case "${2:-}" in
      --wait) MC_FEEDBACK_WAIT=1 ;;
      '') MC_FEEDBACK_WAIT=0 ;;
      *) echo 'usage: memcap feedback [--wait]' >&2; exit 2 ;;
    esac
    # shellcheck source=/dev/null
    . "$LIB/idle_gc.sh"
    # shellcheck source=/dev/null
    . "$LIB/feedback.sh"
    mc_feedback_hook
    ;;
  agent-hooks)
    # shellcheck source=/dev/null
    . "$LIB/feedback.sh"
    mc_agent_hooks "${2:-}" "${3:-}"
    ;;
  watch)
    # shellcheck source=/dev/null
    . "$LIB/boot_timeout.sh"
    # shellcheck source=/dev/null
    . "$LIB/idle_gc.sh"
    # shellcheck source=/dev/null
    . "$LIB/enforce.sh"
    # shellcheck source=/dev/null
    . "$LIB/jobs.sh"
    # shellcheck source=/dev/null
    . "$LIB/feedback.sh"
    # shellcheck source=/dev/null
    . "$LIB/notify.sh"
    # shellcheck source=/dev/null
    . "$LIB/docker.sh"
    # One file read on a pass where nothing has changed. Here rather than inside
    # mc_watch so that calling the enforcement functions directly -- which the
    # test suite does constantly -- never compiles an app bundle.
    mc_ensure_notifier || :
    mc_watch
    ;;
  clean)
    # shellcheck source=/dev/null
    . "$LIB/enforce.sh"
    # `memcap off` is a kill switch, so it stops manual sweeps too. Otherwise
    # "paused" would mean "paused unless you type the other command".
    if mc_is_paused; then echo "memcap is paused (memcap on to resume)"; exit 0; fi
    # `clean` reaps directly, bypassing every guard mc_watch applies, so it needs
    # its own. Sweeping on defaults the user never chose is the same defect as
    # enforcing on them.
    mc_refuse_if_broken "sweep" || exit 3
    eval "$(mc_ps_snapshot | mc_classify)"
    mc_reap_orphans
    mc_reap_sims
    ;;
  profile)
    shift
    # shellcheck source=/dev/null
    . "$LIB/profile.sh"
    # mc_profile_set rewrites memcap.conf in place. Editing a file that does not
    # parse leaves the break in and adds a value the user cannot see take effect.
    if [ $# -eq 0 ]; then mc_profile_list; else mc_refuse_if_broken "change the profile" || exit 3; mc_profile_set "$1"; fi
    ;;
  docker)
    shift
    case "${1:-}" in
      apply|"") shift 2>/dev/null || true ;;
      *) echo "usage: memcap docker apply [--force]" >&2; exit 2 ;;
    esac
    # shellcheck source=/dev/null
    . "$LIB/docker.sh"
    # Writes DOCKER_BUDGET_GB/DOCKER_CPUS into Docker's own settings. On a broken
    # config those are the built-in fallbacks, not the user's numbers, and the
    # write outlives the mistake.
    mc_refuse_if_broken "apply Docker settings" || exit 3
    mc_docker_apply "$@"
    ;;
  # Both write to actions.log. They used to write nothing at all, so a week
  # spent paused and a week spent dead read identically in the audit trail --
  # and since `on` deletes the marker, even the fact that a pause happened was
  # gone. mc_pause also dates the marker so `status` can say how long it held.
  notify)
    shift
    if [ $# -gt 0 ]; then echo "usage: memcap notify" >&2; exit 2; fi
    # shellcheck source=/dev/null
    . "$LIB/notify.sh"
    mc_notify_command
    ;;
  off)    mc_pause; echo "memcap paused" ;;
  on)     mc_resume ;;
  service)
    shift
    # shellcheck source=/dev/null
    . "$LIB/service.sh"
    case "${1:-}" in
      install)   mc_service_install ;;
      uninstall) mc_service_uninstall ;;
      status)    mc_service_status ;;
      *) echo "usage: memcap service install|uninstall|status" >&2; exit 2 ;;
    esac
    ;;
  uninstall)
    shift
    # Validate before acting, the same lesson as `docker apply`: the dispatcher routes
    # every `memcap uninstall <anything>` here, so a stray argument must be rejected
    # before the rm -rf runs, not after.
    if [ $# -gt 0 ]; then echo "usage: memcap uninstall" >&2; exit 2; fi
    # shellcheck source=/dev/null
    . "$LIB/service.sh"
    mc_service_uninstall
    rm -rf "$(mc_state_dir)"
    echo "Removed memcap state ($(mc_state_dir))."
    echo "Config kept at $(mc_config_file) — delete it yourself for a clean slate."
    echo "Then: brew uninstall memcap"
    ;;
  # `memcap version` used to be "unknown command", so the only way to tell
  # which build was installed was to read the Cellar path -- and log lines
  # carried no version at all. Both matter when the evidence for a bug is nine
  # days of one machine's actions.log.
  version|--version|-v) echo "memcap $MEMCAP_VERSION" ;;
  help|--help|-h) echo "memcap $MEMCAP_VERSION — keep AI agents inside a RAM budget"; echo "usage: memcap {init|integrate|doctor|status|diagnostics|gc|run [options] -- command|queue [--json]|feedback|agent-hooks codex|claude [--queue]|watch|clean|profile|docker [apply [--force]]|notify|off|on|service [install|uninstall|status]|uninstall|version}" ;;
  *) echo "unknown command: $1" >&2; exit 1 ;;
esac
