[
  {"name":"parameter substitution", "command":"aws ssm get-parameter --name \"$(cat parameter-name)\" --with-decryption", "expected":"light"},
  {"name":"SSM helper", "command":"ssm() { aws ssm get-parameter --name \"$1\"; }; ssm fixture", "expected":"light"},
  {"name":"Git delivery", "command":"git add file && git commit -m 'fixture' && git push origin main && git status", "expected":"light"},
  {"name":"Git config", "command":"git config --get core.hooksPath", "expected":"light"},
  {"name":"metadata chain", "command":"cat CONTRIBUTING.md && ls -la .claude && git remote -v && git log -5 --oneline", "expected":"light"},
  {"name":"glob search", "command":"rg -n 'func Store' -A 60 *.go | rg kept | head -30", "expected":"light"},
  {"name":"option prefix", "command":"set -euo pipefail; aws --new-option ssm get-parameter --name fixture", "expected":"light"},
  {"name":"Python text", "command":"python3 -c 'from pathlib import Path; print(Path(\"note\").read_text())'", "expected":"light"},
  {"name":"PDF render", "command":"weasyprint report.html report.pdf", "expected":"light"},
  {"name":"unknown helper", "command":"python3 unknown-helper.py", "expected":"light"},
  {"name":"remote build", "command":"ssh host 'npm run build'", "expected":"light"},
  {"name":"remote dispatch", "command":"aws ssm send-command --parameters 'commands=[\"go build ./...\"]'", "expected":"light"},
  {"name":"GitHub edit", "command":"gh pr edit 123 --body-file notes.md", "expected":"light"},
  {"name":"curl fallback", "command":"curl -H \"Authorization: ${API_KEY:-$FALLBACK}\" https://example.invalid", "expected":"light"},
  {"name":"file loop", "command":"for file in *.md; do cat \"$file\"; done", "expected":"light"},
  {"name":"data heredoc", "command":"cat <<'EOF'\ngo test ./...\nEOF", "expected":"light"},
  {"name":"heap ceiling", "command":"node --max-old-space-size=4096 helper.js", "expected":"light"},
  {"name":"Go test", "command":"go test ./...", "expected":"heavy"},
  {"name":"Go directory", "command":"go -C backend test ./...", "expected":"heavy"},
  {"name":"build chain", "command":"git status && go build ./cmd/app", "expected":"heavy"},
  {"name":"compiler env", "command":"env GOOS=darwin go build ./...", "expected":"heavy"},
  {"name":"shell wrapper", "command":"bash -lc 'cargo test'", "expected":"heavy"},
  {"name":"env split", "command":"env -S 'npm test'", "expected":"heavy"},
  {"name":"process substitution", "command":"cat <(npm test)", "expected":"heavy"},
  {"name":"local substitution", "command":"aws ssm get-parameter --name \"$(go test ./...)\"", "expected":"heavy"},
  {"name":"Python subprocess", "command":"python3 -c 'import subprocess; subprocess.run([\"go\", \"test\", \"./...\"])'", "expected":"heavy"},
  {"name":"Python heredoc", "command":"python3 - <<'PY'\nimport subprocess\nsubprocess.run(['go', 'test', './...'])\nPY", "expected":"heavy"},
  {"name":"Docker build", "command":"docker build .", "expected":"heavy"},
  {"name":"simulator start", "command":"xcrun simctl boot FIXTURE", "expected":"heavy"},
  {"name":"browser tests", "command":"npx playwright test", "expected":"heavy"},
  {"name":"Python tests", "command":"python3 -m pytest tests/", "expected":"heavy"},
  {"name":"test loop", "command":"for f in a b; do go test \"$f\"; done", "expected":"heavy"},
  {"name":"literal hash", "command":"echo ''#literal && npm test", "expected":"heavy"}
